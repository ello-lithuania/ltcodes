# Maintainer: KokybiskaSvetaine.lt (Justas Arbatauskis) <info at kokybiskasvetaine dot lt>
pkgname=ltcodes
pkgver=0.2.0
pkgrel=1
pkgdesc="Validate Lithuanian personal codes, company codes, VAT numbers and IBANs from the command line"
arch=('x86_64' 'aarch64')
url="https://kokybiskasvetaine.lt/"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ello-lithuania/ltcodes/archive/refs/tags/rust-v$pkgver.tar.gz")
sha256sums=('c7da58adbd6a878c736b1bc2e72427177d26dff89495f86ea06a24416ffb0406')

prepare() {
  cd "ltcodes-rust-v$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "ltcodes-rust-v$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "ltcodes-rust-v$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "ltcodes-rust-v$pkgver/rust"
  install -Dm755 target/release/ltcodes "$pkgdir/usr/bin/ltcodes"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
